# Copy to .env for local use. Never commit real secrets to GitHub.
PORT=3000
NODE_ENV=development
SITE_NAME=AliCreates
SITE_URL=http://localhost:3000

# PostgreSQL connection string. Create a database before running.
DATABASE_URL=postgresql://postgres:password@localhost:5432/alicreates
# Set true only if your database provider requires SSL (Render Postgres often does externally).
PGSSL=false

# Admin login. Use a long unique password. First admin is created automatically.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Use a random long secret (32+ characters). Keep private.
SESSION_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters

# Cloudinary media storage. Video files are stored in cloud storage, not ephemeral app disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public contact/social links shown on the portfolio
WHATSAPP_NUMBER=923001234567
CONTACT_EMAIL=you@example.com
INSTAGRAM_URL=
TIKTOK_URL=
FACEBOOK_URL=
X_URL=

# Upload limit in MB (default 100). Provider/account limits may be lower.
MAX_VIDEO_MB=100
