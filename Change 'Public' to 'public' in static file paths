<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#07111f"><title>Admin Dashboard — AliCreates</title><link rel="stylesheet" href="/style.css"></head><body class="admin-body"><header class="topbar"><a class="brand" href="/"><span class="logo">▶</span><span><b>Ali<span>Creates</span></b><small>ADMIN WORKSPACE</small></span></a><nav><a href="/">View public website ↗</a></nav></header><main class="admin-wrap"><section id="loginPanel" class="card login-card"><div class="eyebrow">PRIVATE WORKSPACE</div><h1>Admin <em>Login</em></h1><p class="muted">Sign in to manage videos, social links and contact details.</p><form id="loginForm"><label>Admin email<input id="loginEmail" type="email" autocomplete="username" required placeholder="you@example.com"></label><label>Password<input id="loginPassword" type="password" autocomplete="current-password" required placeholder="Your password"></label><button class="btn yellow full">Sign in securely</button><p class="error" id="loginError"></p></form></section>
<section id="dashboard" hidden><div class="admin-heading"><div><div class="eyebrow">CONTROL PANEL</div><h1>Portfolio <em>Manager</em></h1><p class="muted">Upload a video or add a YouTube/direct video link. Published changes appear on the public site immediately.</p></div><button id="logout" class="btn outline">Log out</button></div>
<div class="admin-tabs"><button class="tab active" data-tab="videos">Video manager</button><button class="tab" data-tab="settings">Contact & socials</button><button class="tab" data-tab="security">Change password</button></div>
<section id="tab-videos" class="admin-columns"><form id="videoForm" class="card"><h2 id="videoFormTitle">Add a video</h2><input type="hidden" id="videoId"><label>Video title<input id="title" required maxlength="120" placeholder="e.g. Luxury Perfume Ad"></label><label>Category<select id="category"><option>Beauty</option><option>Tech</option><option>Fashion</option><option>Other</option></select></label><label>Description<textarea id="description" maxlength="500" rows="3" placeholder="Short description for clients"></textarea></label><label>Video file (optional)<input id="videoFile" type="file" accept="video/mp4,video/webm,video/quicktime,video/x-m4v"></label><p class="tiny muted">File upload needs Cloudinary keys configured. Maximum upload size is set in server environment (default 100 MB).</p><div class="upload-progress" id="uploadProgress" hidden>Uploading video…</div><label>Or video URL<input id="videoUrl" type="url" placeholder="YouTube URL or direct MP4 URL"></label><label>Playback type<select id="videoType"><option value="youtube">YouTube video</option><option value="external">External/direct video URL</option><option value="cloudinary">Cloud video</option></select></label><label>Poster/thumbnail URL (optional)<input id="posterUrl" type="url" placeholder="https://…"></label><label>Duration label<input id="duration" maxlength="30" placeholder="15 sec"></label><label class="check-label"><input id="featured" type="checkbox"> Feature this sample near the top</label><div class="form-actions"><button class="btn yellow">Save video</button><button class="btn outline" type="button" id="resetVideo">Clear</button></div><p class="tiny" id="videoMessage"></p></form><div class="card"><div class="list-head"><h2>Published samples</h2><span class="count" id="videoCount">0</span></div><div id="videoList" class="admin-list"><p class="muted tiny">Loading…</p></div></div></section>
<section id="tab-settings" class="card settings-panel" hidden><h2>Contact & social media</h2><p class="muted tiny">These details appear on the public website. Add only links you control.</p><form id="settingsForm" class="settings-grid"><label>Website name<input id="site_name" maxlength="80"></label><label>WhatsApp number (country code + number)<input id="whatsapp" placeholder="923001234567"></label><label>Contact email<input id="contact_email" type="email"></label><label>Instagram URL<input id="instagram" type="url" placeholder="https://instagram.com/…"></label><label>TikTok URL<input id="tiktok" type="url" placeholder="https://tiktok.com/@…"></label><label>Facebook URL<input id="facebook" type="url" placeholder="https://facebook.com/…"></label><label>X / Twitter URL<input id="x" type="url" placeholder="https://x.com/…"></label><button class="btn yellow">Save settings</button><p class="tiny" id="settingsMessage"></p></form></section>
<section id="tab-security" class="card settings-panel" hidden><h2>Change admin password</h2><form id="passwordForm" class="password-form"><label>Current password<input id="currentPassword" type="password" required autocomplete="current-password"></label><label>New password (at least 12 characters)<input id="newPassword" type="password" minlength="12" required autocomplete="new-password"></label><button class="btn yellow">Update password</button><p class="tiny" id="passwordMessage"></p></form></section>
</section></main><script src="/admin.js"></script></body></html>
